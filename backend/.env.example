# ============================================
#  RTNote Backend - Plantilla de variables de entorno
#  Copia este archivo a ".env" y rellena los valores.
#  NUNCA subas el archivo .env al repositorio.
# ============================================

# --- Servidor ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=rtnote_user
DB_PASSWORD=cambia_esta_contraseña
DB_NAME=rtnote
# true si tu PostgreSQL exige SSL (normalmente false en localhost)
DB_SSL=false

# --- JWT ---
# Genera uno seguro con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Telegram (@rtnotebot) ---
# Token obtenido de @BotFather
TELEGRAM_BOT_TOKEN=

# --- Zona horaria ---
# Fechas sin offset se interpretan en esta zona; Telegram muestra la hora aquí.
APP_TIMEZONE=America/Tegucigalpa

# --- Scheduler de notificaciones ---
SCHEDULER_ENABLED=true
SCHEDULER_CRON=* * * * *
SCHEDULER_BATCH_SIZE=50
REMINDER_MAX_ATTEMPTS=5

# --- CORS ---
# Orígenes permitidos separados por coma (sin barra final)
CORS_ORIGINS=https://rtnotebot.rtdev.uk,http://localhost:5500,http://127.0.0.1:5500
